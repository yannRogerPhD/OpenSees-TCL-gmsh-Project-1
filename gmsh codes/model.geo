Coherence;

XMIN_SOIL = -130; XMAX_SOIL = 130;
YMIN_SOIL = -130; YMAX_SOIL = 130;
ZMIN_SOIL = -140; ZMAX_SOIL = 0;

tAbsB = 20; nAbsB = 1;
tAbsL = 20; nAbsL = 1;
tAbsR = 20; nAbsR = 1;
tAbsF = 20; nAbsF = 1;
tAbsK = 20; nAbsK = 1;


// bottom boundary faces: z = ZMIN_SOIL (within eps)
sBottom[] = Surface In BoundingBox {XMIN_SOIL-eps, YMIN_SOIL-eps, ZMIN_SOIL-eps, XMAX_SOIL+eps, YMAX_SOIL+eps, ZMIN_SOIL+eps};
sBottom[] = Unique(Abs(sBottom[]));

// Extrude outward along -Z (Bottom)
If (#sBottom[] > 0)
  Extrude {0, 0, -tAbsB} {
    Surface{sBottom[]}; Layers{nAbsB}; Recombine;
  }
EndIf


// left boundary faces: x = XMIN_SOIL (within eps)
sLeft[] = Surface In BoundingBox {XMIN_SOIL-eps, YMIN_SOIL-eps, ZMIN_SOIL-eps, XMIN_SOIL+eps, YMAX_SOIL+eps, ZMAX_SOIL+eps};
sLeft[] = Unique(Abs(sLeft[]));

// Extrude outward along -X (Left)
If (#sLeft[] > 0)
  Extrude {-tAbsL, 0, 0} {
    Surface{sLeft[]}; Layers{nAbsL}; Recombine;
  }
EndIf


// right boundary faces: x = XMAX_SOIL (within eps)
sRight[] = Surface In BoundingBox {XMAX_SOIL-eps, YMIN_SOIL-eps, ZMIN_SOIL-eps, XMAX_SOIL+eps, YMAX_SOIL+eps, ZMAX_SOIL+eps};
sRight[] = Unique(Abs(sRight[]));

// Extrude outward along +X (Right)
If (#sRight[] > 0)
  Extrude {tAbsR, 0, 0} {
    Surface{sRight[]}; Layers{nAbsR}; Recombine;
  }
EndIf

transX_col1 = Ceil(52/52) + 1;
transY_row1 = Ceil(52/52) + 1;
transZ_L1 = Ceil(20/1.25) + 1;
transX_col2 = Ceil(52/52) + 1;
transX_col3 = Ceil(52/52) + 1;
transX_col4 = Ceil(52/52) + 1;
transX_col5 = Ceil(52/52) + 1;
transY_row2 = Ceil(52/52) + 1;
transY_row3 = Ceil(52/52) + 1;
transY_row4 = Ceil(52/52) + 1;
transY_row5 = Ceil(52/52) + 1;
transZ_L2 = Ceil(30/1.5) + 1;
transZ_L3 = Ceil(40/1.25) + 1;
transZ_L4 = Ceil(50/1.25) + 1;

X_1_0 = -104; Y_1_0 = -104; Z_1_0 = 0;
Lx_1 = 52; Ly_1 = 52; Lz_1 = 20;
xMin_1_0 = (X_1_0 - Lx_1/2); xMax_1_0 = (X_1_0 + Lx_1/2);
yMin_1_0 = (Y_1_0 - Ly_1/2); yMax_1_0 = (Y_1_0 + Ly_1/2);
zMin_1_0 = (Z_1_0 - Lz_1); zMax_1_0 = (Z_1_0);
cX_1_0[] = {}; cY_1_0[] = {}; cZ_1_0[] = {};
cX_1_0[] += Curve In BoundingBox { xMin_1_0-eps, yMin_1_0-eps, zMin_1_0-eps, xMax_1_0+eps, yMin_1_0+eps, zMin_1_0+eps };
cX_1_0[] += Curve In BoundingBox { xMin_1_0-eps, yMin_1_0-eps, zMax_1_0-eps, xMax_1_0+eps, yMin_1_0+eps, zMax_1_0+eps };
cX_1_0[] += Curve In BoundingBox { xMin_1_0-eps, yMax_1_0-eps, zMin_1_0-eps, xMax_1_0+eps, yMax_1_0+eps, zMin_1_0+eps };
cX_1_0[] += Curve In BoundingBox { xMin_1_0-eps, yMax_1_0-eps, zMax_1_0-eps, xMax_1_0+eps, yMax_1_0+eps, zMax_1_0+eps };
cY_1_0[] += Curve In BoundingBox { xMin_1_0-eps, yMin_1_0-eps, zMin_1_0-eps, xMin_1_0+eps, yMax_1_0+eps, zMin_1_0+eps };
cY_1_0[] += Curve In BoundingBox { xMin_1_0-eps, yMin_1_0-eps, zMax_1_0-eps, xMin_1_0+eps, yMax_1_0+eps, zMax_1_0+eps };
cY_1_0[] += Curve In BoundingBox { xMax_1_0-eps, yMin_1_0-eps, zMin_1_0-eps, xMax_1_0+eps, yMax_1_0+eps, zMin_1_0+eps };
cY_1_0[] += Curve In BoundingBox { xMax_1_0-eps, yMin_1_0-eps, zMax_1_0-eps, xMax_1_0+eps, yMax_1_0+eps, zMax_1_0+eps };
cZ_1_0[] += Curve In BoundingBox { xMin_1_0-eps, yMin_1_0-eps, zMin_1_0-eps, xMin_1_0+eps, yMin_1_0+eps, zMax_1_0+eps };
cZ_1_0[] += Curve In BoundingBox { xMin_1_0-eps, yMax_1_0-eps, zMin_1_0-eps, xMin_1_0+eps, yMax_1_0+eps, zMax_1_0+eps };
cZ_1_0[] += Curve In BoundingBox { xMax_1_0-eps, yMin_1_0-eps, zMin_1_0-eps, xMax_1_0+eps, yMin_1_0+eps, zMax_1_0+eps };
cZ_1_0[] += Curve In BoundingBox { xMax_1_0-eps, yMax_1_0-eps, zMin_1_0-eps, xMax_1_0+eps, yMax_1_0+eps, zMax_1_0+eps };
cX_1_0[] = Unique(Abs(cX_1_0[]));
cY_1_0[] = Unique(Abs(cY_1_0[]));
cZ_1_0[] = Unique(Abs(cZ_1_0[]));
Transfinite Curve {cX_1_0[]} = transX_col1 Using Progression 1;
Transfinite Curve {cY_1_0[]} = transY_row1 Using Progression 1;
Transfinite Curve {cZ_1_0[]} = transZ_L1 Using Progression 1;

