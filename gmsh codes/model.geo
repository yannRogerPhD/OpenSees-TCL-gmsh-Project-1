cZ_99_0[] += Curve In BoundingBox { xMax_99_0-eps, yMin_99_0-eps, zMin_99_0-eps, xMax_99_0+eps, yMin_99_0+eps, zMax_99_0+eps };
cZ_99_0[] += Curve In BoundingBox { xMax_99_0-eps, yMax_99_0-eps, zMin_99_0-eps, xMax_99_0+eps, yMax_99_0+eps, zMax_99_0+eps };
cX_99_0[] = Unique(Abs(cX_99_0[]));
cY_99_0[] = Unique(Abs(cY_99_0[]));
cZ_99_0[] = Unique(Abs(cZ_99_0[]));
Transfinite Curve {cX_99_0[]} = transX_col4 Using Progression 1;
Transfinite Curve {cY_99_0[]} = transY_row5 Using Progression 1;
Transfinite Curve {cZ_99_0[]} = transZ_L4 Using Progression 1;

X_100_0 = 104; Y_100_0 = 104; Z_100_0 = -90;
Lx_100 = 52; Ly_100 = 52; Lz_100 = 50;
xMin_100_0 = (X_100_0 - Lx_100/2); xMax_100_0 = (X_100_0 + Lx_100/2);
yMin_100_0 = (Y_100_0 - Ly_100/2); yMax_100_0 = (Y_100_0 + Ly_100/2);
zMin_100_0 = (Z_100_0 - Lz_100); zMax_100_0 = (Z_100_0);
cX_100_0[] = {}; cY_100_0[] = {}; cZ_100_0[] = {};
cX_100_0[] += Curve In BoundingBox { xMin_100_0-eps, yMin_100_0-eps, zMin_100_0-eps, xMax_100_0+eps, yMin_100_0+eps, zMin_100_0+eps };
cX_100_0[] += Curve In BoundingBox { xMin_100_0-eps, yMin_100_0-eps, zMax_100_0-eps, xMax_100_0+eps, yMin_100_0+eps, zMax_100_0+eps };
cX_100_0[] += Curve In BoundingBox { xMin_100_0-eps, yMax_100_0-eps, zMin_100_0-eps, xMax_100_0+eps, yMax_100_0+eps, zMin_100_0+eps };
cX_100_0[] += Curve In BoundingBox { xMin_100_0-eps, yMax_100_0-eps, zMax_100_0-eps, xMax_100_0+eps, yMax_100_0+eps, zMax_100_0+eps };
cY_100_0[] += Curve In BoundingBox { xMin_100_0-eps, yMin_100_0-eps, zMin_100_0-eps, xMin_100_0+eps, yMax_100_0+eps, zMin_100_0+eps };
cY_100_0[] += Curve In BoundingBox { xMin_100_0-eps, yMin_100_0-eps, zMax_100_0-eps, xMin_100_0+eps, yMax_100_0+eps, zMax_100_0+eps };
cY_100_0[] += Curve In BoundingBox { xMax_100_0-eps, yMin_100_0-eps, zMin_100_0-eps, xMax_100_0+eps, yMax_100_0+eps, zMin_100_0+eps };
cY_100_0[] += Curve In BoundingBox { xMax_100_0-eps, yMin_100_0-eps, zMax_100_0-eps, xMax_100_0+eps, yMax_100_0+eps, zMax_100_0+eps };
cZ_100_0[] += Curve In BoundingBox { xMin_100_0-eps, yMin_100_0-eps, zMin_100_0-eps, xMin_100_0+eps, yMin_100_0+eps, zMax_100_0+eps };
cZ_100_0[] += Curve In BoundingBox { xMin_100_0-eps, yMax_100_0-eps, zMin_100_0-eps, xMin_100_0+eps, yMax_100_0+eps, zMax_100_0+eps };
cZ_100_0[] += Curve In BoundingBox { xMax_100_0-eps, yMin_100_0-eps, zMin_100_0-eps, xMax_100_0+eps, yMin_100_0+eps, zMax_100_0+eps };
cZ_100_0[] += Curve In BoundingBox { xMax_100_0-eps, yMax_100_0-eps, zMin_100_0-eps, xMax_100_0+eps, yMax_100_0+eps, zMax_100_0+eps };
cX_100_0[] = Unique(Abs(cX_100_0[]));
cY_100_0[] = Unique(Abs(cY_100_0[]));
cZ_100_0[] = Unique(Abs(cZ_100_0[]));
Transfinite Curve {cX_100_0[]} = transX_col5 Using Progression 1;
Transfinite Curve {cY_100_0[]} = transY_row5 Using Progression 1;
Transfinite Curve {cZ_100_0[]} = transZ_L4 Using Progression 1;

// Apply surface/volume transfinite + recombine to all volumes
allVols[] = Unique(Abs(Volume{:}));
For vi In {0:#allVols[]-1}
  vtag = allVols[vi];
  ss[] = Unique(Abs(Boundary{ Volume{vtag}; }));
  Transfinite Surface {ss[]};
  Recombine Surface {ss[]};
  Transfinite Volume {vtag};
EndFor