X0 = 52; Y0 = 104; Z0 = -90;
Lx = Lx_99; Ly = Ly_99; Lz = Lz_99;
TX = transX_col4; TY = transY_row5; TZ = transZ_L4;
Call ApplyBBoxCurveConstraints;

Lx_100 = 52; Ly_100 = 52; Lz_100 = 50;
X0 = 104; Y0 = 104; Z0 = -90;
Lx = Lx_100; Ly = Ly_100; Lz = Lz_100;
TX = transX_col5; TY = transY_row5; TZ = transZ_L4;
Call ApplyBBoxCurveConstraints;

// Apply surface/volume transfinite + recombine to all volumes
allVols[] = Volume{:};
allVols[] = Unique(Abs(allVols[]));
For vi In {0:#allVols[]-1}
  vtag = allVols[vi];
  ss[] = Unique(Abs(Boundary{ Volume{vtag}; }));
  Transfinite Surface {ss[]};
  Recombine Surface {ss[]};
  Transfinite Volume {vtag};
EndFor//+
